<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexLocalDashboard-v1.5.5</AssemblyName>
    <RootNamespace>CodexLocalDashboard</RootNamespace>
    <ApplicationIcon>dashboard.ico</ApplicationIcon>
    <Version>1.5.5</Version>
    <AssemblyVersion>1.5.5.0</AssemblyVersion>
    <FileVersion>1.5.5.0</FileVersion>
    <Product>Codex Local Quota Dashboard</Product>
    <Description>Offline Windows dashboard for locally cached Codex quota and token usage.</Description>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.Framework.cs" />
    <Compile Include="TokenRateChart.cs" />
    <Compile Include="ProjectDetail.cs" />
    <Compile Include="HistoryStore.cs" />
    <Compile Include="HistoryDashboard.cs" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
